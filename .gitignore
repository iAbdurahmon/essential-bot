# secrets
.env
# the Google service-account key lives in the project root; blanket-ignore json so a
# new key can never be committed by accident, and allow data files explicitly
*.json
!data/*.json
!.github/**/*.json

# book content (copyrighted, not for distribution)
data/book_units/
data/user_pdf/

# logs
logs/
*.log

# python
__pycache__/
*.py[cod]
venv/
.venv/

# ide / os
.idea/
.vscode/
.DS_Store

# tests
.pytest_cache/
