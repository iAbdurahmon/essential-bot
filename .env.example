# --- required ---
BOT_TOKEN=123456:your-token-from-botfather

DB_PASSWORD=change-me
# chat where the bot keeps its "about" and changelog posts and copies them from;
# the bot has to be a member of it
ADMIN_GROUP=-1001234567890
ADMIN_ID=123456789

# --- optional, these are the defaults ---
DB_NAME=essential
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432

# leave MONGO_USER empty for an instance without authentication
MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_AUTH_DB=admin
MONGO_DB=essential

REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

# only needed for the translator; without them the bot says it is not configured
GOOGLE_PROJECT=
GOOGLE_CREDENTIALS=
